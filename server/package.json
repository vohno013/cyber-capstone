    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "nodemon index.js",
    "gen-cert": "openssl req -x509 -newkey rsa:2048 -nodes -keyout key.pem -out cert.pem -days 365 -subj \"/CN=localhost\" -addext \"subjectAltName=DNS:localhost,IP:127.0.0.1\"",
    "trust-cert": "powershell -Command \"Import-Certificate -FilePath cert.pem -CertStoreLocation Cert:\\CurrentUser\\Root\"",
    "setup-https": "powershell -ExecutionPolicy Bypass -File setup-https.ps1"
  },
